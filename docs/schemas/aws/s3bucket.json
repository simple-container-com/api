{
  "name": "S3Bucket",
  "type": "resource",
  "provider": "aws",
  "description": "AWS s3bucket configuration",
  "goPackage": "pkg/clouds/aws/",
  "goStruct": "S3Bucket",
  "resourceType": "s3-bucket",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "accessKey": {
        "type": "string"
      },
      "account": {
        "type": "string"
      },
      "allowOnlyHttps": {
        "type": "boolean"
      },
      "baseDnsZone": {
        "type": "string"
      },
      "corsConfig": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "allowedMethods": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "allowedOrigins": {
            "type": "string"
          }
        },
        "required": [
          "allowedOrigins"
        ],
        "type": "object"
      },
      "credentials": {
        "type": "string"
      },
      "domain": {
        "type": "string"
      },
      "errorDocument": {
        "type": "string"
      },
      "indexDocument": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "permissionsBoundary": {
        "type": "string"
      },
      "provisionWwwDomain": {
        "type": "boolean"
      },
      "region": {
        "type": "string"
      },
      "secretAccessKey": {
        "type": "string"
      }
    },
    "required": [
      "accessKey",
      "account",
      "allowOnlyHttps",
      "baseDnsZone",
      "credentials",
      "domain",
      "errorDocument",
      "indexDocument",
      "provisionWwwDomain",
      "region",
      "secretAccessKey"
    ],
    "type": "object"
  }
}