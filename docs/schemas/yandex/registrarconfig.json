{
  "name": "RegistrarConfig",
  "type": "resource",
  "provider": "yandex",
  "description": "YANDEX registrar configuration",
  "goPackage": "pkg/clouds/yandex/",
  "goStruct": "RegistrarConfig",
  "resourceType": "yc-dns",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "accessKey": {
        "type": "string"
      },
      "certificateId": {
        "type": "string"
      },
      "cloudId": {
        "type": "string"
      },
      "credentials": {
        "type": "string"
      },
      "dnsRecords": {
        "items": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "name": {
              "type": "string"
            },
            "priority": {
              "type": "integer"
            },
            "proxied": {
              "type": "boolean"
            },
            "type": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "proxied",
            "type",
            "value"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "folderId": {
        "type": "string"
      },
      "recordTtl": {
        "type": "integer"
      },
      "region": {
        "type": "string"
      },
      "secretAccessKey": {
        "type": "string"
      },
      "serviceAccountKey": {
        "type": "string"
      },
      "zone": {
        "type": "string"
      },
      "zoneId": {
        "type": "string"
      },
      "zoneName": {
        "type": "string"
      },
      "zoneResourceName": {
        "type": "string"
      }
    },
    "required": [
      "cloudId",
      "credentials",
      "folderId",
      "zoneName"
    ],
    "type": "object"
  }
}