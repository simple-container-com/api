{
  "name": "AccountConfig",
  "type": "auth",
  "provider": "yandex",
  "description": "YANDEX authentication configuration",
  "goPackage": "pkg/clouds/yandex/",
  "goStruct": "AccountConfig",
  "resourceType": "yc-service-account",
  "schema": {
