      },
      "cloudId": {
        "type": "string"
      },
      "credentials": {
        "type": "string"
      },
      "folderId": {
        "type": "string"
      },
      "region": {
        "type": "string"
      },
      "secretAccessKey": {
        "type": "string"
      },
      "serviceAccountKey": {
        "type": "string"
      },
      "zone": {
        "type": "string"
      }
    },
    "required": [
