        "type": "string"
      },
      "credentials": {
        "type": "string"
      },
      "location": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "noncurrentVersionRetentionDays": {
        "type": "integer"
      },
      "projectId": {
        "type": "string"
      },
