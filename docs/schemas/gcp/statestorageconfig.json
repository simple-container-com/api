{
  "name": "StateStorageConfig",
  "type": "provisioner",
  "provider": "gcp",
  "description": "Google Cloud Platform statestorage configuration",
  "goPackage": "pkg/clouds/gcp/",
  "goStruct": "StateStorageConfig",
  "resourceType": "gcp-bucket",
